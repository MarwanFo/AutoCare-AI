# ==============================================================================
# AutoCare-AI - Docker Compose Environment Template
# Copy this file to '.env' at the project root for Docker Compose
# ==============================================================================

# --- PostgreSQL Settings ---
POSTGRES_DB=autocare
POSTGRES_USER=autocare_admin
POSTGRES_PASSWORD=autocare_secure_pass_2026
POSTGRES_PORT=5432

# --- Backend Application Settings ---
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080

# --- JWT Configuration (Base64 minimum 256 bits) ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- External AI & Email Integrations ---
GEMINI_API_KEY=your_gemini_api_key_here
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@autocare.ai
MAIL_PASSWORD=your_mail_smtp_password_here

# --- Cloudinary (Optional Media Uploads) ---
CLOUDINARY_CLOUD_NAME=autocare
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# --- Admin Portal Web Port ---
ADMIN_PORT=80
