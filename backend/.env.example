# ==============================================================================
# AutoCare AI Spring Boot Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit '.env' or any file containing real passwords to Git repository.
# ==============================================================================

# Active Spring Profile (e.g. dev, prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Connection Parameters
DB_URL=jdbc:postgresql://localhost:5432/autocare
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Authenticator Security Keys
# Note: secret must be a base64 encoded key (min 256 bits)
JWT_SECRET=your_base64_encoded_jwt_secret_here
JWT_EXPIRATION_MS=900000

# SMTP Mail Transport Settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@autocare.ai
MAIL_PASSWORD=your_mail_smtp_password_here

# Gemini Generative AI Platform Config
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Media Storage (If Used)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
